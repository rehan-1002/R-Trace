# Environment variables for R-TRACE
# Copy this file to .env and fill in the values.
# Variables prefixed with VITE_ are exposed to the client bundle.
# Never put secrets in VITE_ variables.

# Data mode: 'mock' | 'live'
# Use 'mock' during development without hardware/backend.
VITE_DATA_MODE=mock

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3001

# WebSocket URL for live telemetry from the edge
VITE_WS_URL=ws://localhost:3001/ws

# Map tile URL template (use {} placeholders as per Leaflet convention)
# Default: OpenStreetMap (no API key required for development)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# App version (informational)
VITE_APP_VERSION=0.1.0
